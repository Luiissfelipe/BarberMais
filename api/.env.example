NODE_ENV=development
PORT=3000
POSTGRES_USER=barbermais
# Use só letras e números (por exemplo: openssl rand -hex 24). Os caracteres / # ? quebram a URL do banco e o $ é trocado pelo Compose.
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=barbermais
DATABASE_URL=postgresql://barbermais:troque_esta_senha@localhost:5432/barbermais
